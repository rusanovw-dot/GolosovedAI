                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="GenerateSummaryButton" Content="{DynamicResource Button_GenerateSummary}"
                                Background="#6200EE" Foreground="White" Padding="15,8" FontWeight="Bold" BorderThickness="0"
                                Click="GenerateSummary_Click" Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource Label_Template}" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox x:Name="TemplateCombo" Width="100" Height="25" Background="#333337" Foreground="White" BorderBrush="#3F3F46">
                            <ComboBoxItem Content="{DynamicResource Template_Meeting}" IsSelected="True"/>
                            <ComboBoxItem Content="{DynamicResource Template_Interview}"/>
                            <ComboBoxItem Content="{DynamicResource Template_Lecture}"/>
                            <ComboBoxItem Content="{DynamicResource Template_General}"/>
                        </ComboBox>
                    </StackPanel>

