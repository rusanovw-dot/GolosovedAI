                            <ComboBoxItem Content="MD" Tag="md"/>
                            <ComboBoxItem Content="SRT" Tag="srt"/>
                            <ComboBoxItem Content="JSON" Tag="json"/>
                            <ComboBoxItem Content="VTT" Tag="vtt"/>
                            <ComboBoxItem Content="PDF" Tag="pdf"/>
