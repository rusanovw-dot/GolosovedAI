<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Window Title -->
    <sys:String x:Key="WindowTitle">Golosoved AI — local voice recorder and transcriber</sys:String>

    <!-- Left panel: block headers -->
    <sys:String x:Key="Label_Files">FILES</sys:String>
    <sys:String x:Key="Label_Recording">RECORDING</sys:String>
    <sys:String x:Key="Label_ModelSettings">RECOGNITION MODEL SETTINGS</sys:String>
    <sys:String x:Key="Label_AISummary">AI SUMMARIZATION</sys:String>
    <sys:String x:Key="Label_SaveAudio">SAVE AUDIO</sys:String>

    <!-- Buttons and checkboxes -->
    <sys:String x:Key="Button_SelectFile">📁 Select and Recognize</sys:String>
    <sys:String x:Key="CheckBox_SaveAudioOriginal">Save original audio</sys:String>
    <sys:String x:Key="Radio_SystemSound">System sound</sys:String>
    <sys:String x:Key="Radio_Microphone">Microphone</sys:String>
    <sys:String x:Key="Button_Record">▶ Record</sys:String>
    <sys:String x:Key="Button_Stop">⏹ Stop</sys:String>
    <sys:String x:Key="CheckBox_SaveAudioOnRecord">Save audio on record</sys:String>
    <sys:String x:Key="Button_Download">Download</sys:String>
    <sys:String x:Key="Button_Browse">Browse...</sys:String>
    <sys:String x:Key="Button_Refresh">🔄</sys:String>

    <!-- Labels and hints -->
    <sys:String x:Key="Label_RecognitionLanguage">Recognition language:</sys:String>
    <sys:String x:Key="Hint_DefaultAudioFolder">(leave empty for default folders)</sys:String>
    <sys:String x:Key="ToolTip_AudioFolder">If left empty: for Files — source folder, for Recording — Records folder in the program folder.</sys:String>

    <!-- Tabs -->
    <sys:String x:Key="Tab_FullText">📄 Full Text</sys:String>
    <sys:String x:Key="Tab_AISummary">🧠 AI Summary</sys:String>
    <sys:String x:Key="Tab_Help">❓ Help</sys:String>

    <!-- Placeholders -->
    <sys:String x:Key="Placeholder_Result">Recognition result will appear here. You can also drag and drop audio, video, PDF, or TXT files into this window for recognition.</sys:String>
    <sys:String x:Key="Placeholder_Summary">AI summary will appear here after you click "Generate AI Summary" and select a suitable template.</sys:String>

    <!-- Bottom panel -->
    <sys:String x:Key="Button_GenerateSummary">🧠 Generate AI Summary</sys:String>
    <sys:String x:Key="Label_Template">Template:</sys:String>
    <sys:String x:Key="Label_Format">Format:</sys:String>
    <sys:String x:Key="Button_SaveAs">💾 Save as...</sys:String>

    <!-- Templates -->
    <sys:String x:Key="Template_Meeting">Meeting</sys:String>
    <sys:String x:Key="Template_Interview">Interview</sys:String>
    <sys:String x:Key="Template_Lecture">Lecture</sys:String>
    <sys:String x:Key="Template_General">General</sys:String>

    <!-- Status -->
    <sys:String x:Key="Status_Default">Waiting for file...</sys:String>
    <sys:String x:Key="Status_Label">Status:</sys:String>

    <!-- Added program strings -->
    <sys:String x:Key="Title_Error">Error</sys:String>
    <sys:String x:Key="Title_Info">Information</sys:String>
    <sys:String x:Key="Title_Success">Success</sys:String>
    <sys:String x:Key="Dialog_OpenMediaFilter">Media, text and PDF|*.mp4;*.avi;*.mov;*.mkv;*.wmv;*.mp3;*.wav;*.m4a;*.flac;*.txt;*.pdf|All files|*.*</sys:String>
    <sys:String x:Key="Dialog_OpenMediaTitle">Select a video, audio or text file</sys:String>

    <sys:String x:Key="Status_LoadingTextFile">Loading text file...</sys:String>
    <sys:String x:Key="Result_FileEmpty">File is empty.</sys:String>
    <sys:String x:Key="Status_ReadyEmptyFile">Done (empty file)</sys:String>
    <sys:String x:Key="Status_TextFileLoaded">Text file loaded: {0}</sys:String>
    <sys:String x:Key="Error_ReadTextFile">Failed to read text file: {0}</sys:String>
    <sys:String x:Key="Status_ErrorReadingTxt">TXT read error</sys:String>

    <sys:String x:Key="Status_ExtractingPdf">Extracting text from PDF...</sys:String>
    <sys:String x:Key="Result_PdfNoText">PDF contains no text (maybe a scanned PDF).</sys:String>
    <sys:String x:Key="Status_ReadyEmptyPdf">Done (empty PDF)</sys:String>
    <sys:String x:Key="Status_PdfTextLoaded">PDF text loaded: {0}</sys:String>
    <sys:String x:Key="Error_ExtractPdf">Failed to extract text from PDF: {0}</sys:String>
    <sys:String x:Key="Status_ErrorReadingPdf">PDF read error</sys:String>

    <sys:String x:Key="Status_Converting">Converting...</sys:String>
    <sys:String x:Key="DefaultFileSuffix_Audio">_audio.wav</sys:String>
    <sys:String x:Key="Status_AudioSavedAndRecognizing">Audio saved: {0}. Recognizing...</sys:String>
    <sys:String x:Key="Status_RecognizingInProgress">Recognizing...</sys:String>
    <sys:String x:Key="Status_RecognizingSpeech">Recognizing speech...</sys:String>
    <sys:String x:Key="Status_RecognizingProgress">Recognizing speech... {0}%</sys:String>
    <sys:String x:Key="Result_SpeechNotRecognized">Speech not recognized.</sys:String>
    <sys:String x:Key="Status_DoneAudioSaved">Done. Audio saved: {0}</sys:String>
    <sys:String x:Key="Status_Done">Done</sys:String>
    <sys:String x:Key="Status_RecognitionCancelled">Recognition cancelled.</sys:String>

    <sys:String x:Key="Message_SelectModelFirst">Please select a model from the list first.</sys:String>
    <sys:String x:Key="Download_AlreadyDownloaded">Already downloaded</sys:String>
    <sys:String x:Key="Status_ModelAlreadyDownloaded">Model {0} is already downloaded.</sys:String>
    <sys:String x:Key="Model_NotDownloaded">Model not downloaded. Click 'Download'</sys:String>
    <sys:String x:Key="Model_Downloaded">Model downloaded</sys:String>

    <sys:String x:Key="Message_ConfirmExit">Are you sure you want to exit?</sys:String>
    <sys:String x:Key="Message_OK">OK</sys:String>
    <sys:String x:Key="Message_Cancel">Cancel</sys:String>
    <sys:String x:Key="Message_Button_Download">Download</sys:String>

    <sys:String x:Key="Error_AudioConversion">Conversion error:\n{0}</sys:String>
    <sys:String x:Key="Error_FFmpegNotFound">FFmpeg not found: {0}</sys:String>
    <sys:String x:Key="Error_FFmpegErrorMsg">FFmpeg error:\n{0}</sys:String>
    <sys:String x:Key="Error_FFmpegTimeout">FFmpeg ran too long and was stopped.</sys:String>
    <sys:String x:Key="Error_FFmpegExitedWithCode">FFmpeg exited with error (code {0}):\n{1}</sys:String>
    <sys:String x:Key="Error_Generic">Error: {0}</sys:String>

    <sys:String x:Key="DefaultFileName_Transcription">Transcription</sys:String>
    <sys:String x:Key="DefaultFileName_Summary">Summary</sys:String>
    <sys:String x:Key="Status_SavingAudio">Saving audio...</sys:String>
    <sys:String x:Key="Message_FileSaved">File saved: {0}</sys:String>
    <sys:String x:Key="Error_SaveFile">Error saving file: {0}</sys:String>

    <sys:String x:Key="MicrophoneList_Updated">Microphone list updated</sys:String>
    <sys:String x:Key="Recognition_Language_Auto">Auto</sys:String>
    <sys:String x:Key="Message_NoTextForSummary">No text to summarize.</sys:String>

    <sys:String x:Key="Message_NoData">No data to display.</sys:String>
    <sys:String x:Key="Prompt_DownloadModel">Download model {0}? (size {1})\nThis may take several minutes.</sys:String>
    <sys:String x:Key="Status_ModelDownloading">Downloading...</sys:String>
    <sys:String x:Key="Download_Error">Download error</sys:String>

</ResourceDictionary>